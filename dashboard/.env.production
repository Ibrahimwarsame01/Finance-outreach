# Public Supabase config — inlined into the build by Next.js.
# These are the PUBLISHABLE (anon) values, which are safe to expose in the
# browser by design (they are already shipped in the client bundle). Access
# is controlled by Supabase Row Level Security, NOT by hiding these values.
# The real secret (service_role) is NEVER put here — it stays in the Python
# pipeline's .env only.
NEXT_PUBLIC_SUPABASE_URL=https://bszpenfetvstkzvchcwz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qROIz3Ybi1BYZ8GrVJ-o8A_2l9DD1ME
