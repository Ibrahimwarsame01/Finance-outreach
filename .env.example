# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Gemini (free tier — get key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail App Passwords (one per sender mailbox; must match app_password_env in config.yaml)
# Enable 2FA on each Google account, then generate an App Password under Security settings
GMAIL_APP_PASSWORD_1=xxxx xxxx xxxx xxxx
GMAIL_APP_PASSWORD_2=xxxx xxxx xxxx xxxx

# HMAC secret for signed unsubscribe links — must also be set in Vercel env vars
UNSUBSCRIBE_SECRET=a_long_random_string_at_least_32_chars
